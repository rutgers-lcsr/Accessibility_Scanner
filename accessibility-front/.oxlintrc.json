{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": [
        "typescript",
        "react",
        "nextjs",
        "jsx-a11y",
        "import"
    ],
    "categories": {
        "correctness": "error"
    },
    "rules": {
        "jsx-a11y/no-noninteractive-tabindex": [
            "error",
            {
                "roles": [
                    "tabpanel"
                ],
                "tags": [
                    "section"
                ]
            }
        ]
    }
}
